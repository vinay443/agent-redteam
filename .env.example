# =============================================================================
# agent-redteam — example environment file
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
#     cp .env.example .env
# =============================================================================

# -- LLM backend -------------------------------------------------------------
# Which model backend the whole lab uses (target agent, attacker generator,
# LLM judge). Two options:
#   ollama    -> local Ollama at http://localhost:11434 (DEFAULT, no API key)
#   anthropic -> Anthropic's hosted API (needs ANTHROPIC_API_KEY)
LLM_BACKEND=ollama

# =============================================================================
# Local backend (default): Ollama + Qwen3:4b
# -----------------------------------------------------------------------------
# Prereqs:  install Ollama (https://ollama.com), then:  ollama pull qwen3:4b
# Verify:   curl http://localhost:11434/api/tags   (should list qwen3:4b)
#
# Qwen3:4b supports NATIVE tool calling via Ollama's /api/chat, so the target
# agent uses real structured tool calls (not prompt-scraping). NOTE: a 4B local
# model follows tools/instructions less reliably than a hosted frontier model,
# so tool-use success is lower and there is no `refusal` stop reason. See
# common/llm_client.py and README.md for the full caveat.
# =============================================================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:4b
# Request timeout (seconds) — a local 4B reasoning model can be slow per turn.
OLLAMA_TIMEOUT=300
# Context window passed to Ollama (num_ctx). Bump if prompts/transcripts are long.
OLLAMA_NUM_CTX=8192

# =============================================================================
# Optional alternative backend: Anthropic
# -----------------------------------------------------------------------------
# To use it:  set LLM_BACKEND=anthropic above and put a real key below.
# With LLM_BACKEND=ollama this key is ignored, so the placeholder is fine.
# =============================================================================
ANTHROPIC_API_KEY=not-needed-for-ollama
ANTHROPIC_BASE_URL=https://api.anthropic.com

# -- Models ------------------------------------------------------------------
# Per-role models. Leave these UNSET to default to the active backend's model
# (qwen3:4b for ollama, claude-opus-5 for anthropic). Set them only to override
# a specific role. Changing the target model changes what you are measuring.
# TARGET_MODEL=qwen3:4b
# ATTACKER_MODEL=qwen3:4b
# JUDGE_MODEL=qwen3:4b

# -- Target agent behaviour --------------------------------------------------
TARGET_MAX_TURNS=8
TARGET_MAX_TOKENS=8000
# Anthropic only: low | medium | high | xhigh | max. Ignored by the Ollama backend.
TARGET_EFFORT=medium

# -- Egress allowlist (Anthropic backend only) -------------------------------
# Hostnames the agent may talk to, enforced in code (target_agent/net.py).
# This is the HOST-side value; the container gets its own (below), because a
# containerised Ollama run additionally needs the host's model port.
EGRESS_ALLOWLIST=api.anthropic.com

# -- Container ---------------------------------------------------------------
# These two are the CONTAINER's view, and deliberately have different names from
# their host counterparts above: inside the container `localhost` is the
# container, so the host's Ollama is reached through host.docker.internal (mapped
# by `extra_hosts: host-gateway` in docker/docker-compose.yml). Distinct names
# stop the host values leaking in and pointing the container at itself.
# Both are optional — docker-compose.yml already defaults to exactly these.
#   OLLAMA_CONTAINER_BASE_URL=http://host.docker.internal:11434
#   CONTAINER_EGRESS_ALLOWLIST=api.anthropic.com,host.docker.internal:11434
# The host:port entry permits that host on that port only; see SAFETY.md.
CONTAINER_NAME=agent-redteam-target
# On Linux/macOS set these so the container user can write to ./sandbox:
#   AGENT_UID=$(id -u)
#   AGENT_GID=$(id -g)
# On Docker Desktop (Windows/macOS) the defaults below are fine.
AGENT_UID=10001
AGENT_GID=10001

# -- Storage -----------------------------------------------------------------
RESULTS_DIR=results
