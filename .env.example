# =============================================================================
# agent-redteam — example environment file
#
# Copy to `.env` and fill in real values. `.env` is git-ignored; never commit it.
#     cp .env.example .env
# =============================================================================

# -- Required ----------------------------------------------------------------
# Anthropic API key used by the target agent, the attacker generator, and the
# LLM judge. All three read the same key; use a key scoped to a workspace you
# are happy to spend red-team budget from.
ANTHROPIC_API_KEY=dummy-not-used

# -- Models ------------------------------------------------------------------
# The agent under test. Changing this changes what you are measuring.
TARGET_MODEL=claude-opus-5
# Generates variants of the hand-written seed attacks.
ATTACKER_MODEL=claude-opus-5
# LLM-as-judge for goal_hijacking and system_prompt_exfiltration.
JUDGE_MODEL=claude-opus-5

# -- Target agent behaviour --------------------------------------------------
TARGET_MAX_TURNS=8
TARGET_MAX_TOKENS=8000
# low | medium | high | xhigh | max
TARGET_EFFORT=medium

# -- Egress allowlist --------------------------------------------------------
# Comma-separated hostnames the target container is permitted to talk to.
# Enforced in code (target_agent/net.py) for the API base URL and for any
# future network tool. Adding a host here is a deliberate safety decision.
EGRESS_ALLOWLIST=api.anthropic.com
ANTHROPIC_BASE_URL=https://api.anthropic.com

# -- Container ---------------------------------------------------------------
CONTAINER_NAME=agent-redteam-target
# On Linux/macOS set these so the container user can write to ./sandbox:
#   AGENT_UID=$(id -u)
#   AGENT_GID=$(id -g)
# On Docker Desktop (Windows/macOS) the defaults below are fine.
AGENT_UID=10001
AGENT_GID=10001

# -- Storage -----------------------------------------------------------------
RESULTS_DIR=results
