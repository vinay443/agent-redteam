# Keep the build context small and, more importantly, keep host secrets and the
# grading code out of the target image.
.git
.gitignore
.env
.env.*
!.env.example
results/
logs/
sandbox/
tests/
attacker/
judge/
runner/
report/
docs/
*.md
.venv/
venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage*
htmlcov/
